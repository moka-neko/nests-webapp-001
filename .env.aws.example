# AWS settings for local ECR push scripts (scripts/aws/*.sh)
# Copy to .env.aws and fill in values:
#   set -a && source .env.aws && set +a

AWS_REGION=ap-northeast-1
ECR_REPOSITORY=juku-api-dev

# Optional image tag. Defaults to current git short SHA.
# IMAGE_TAG=latest

# Also push :latest when IMAGE_TAG is not "latest". Default: true
# PUSH_LATEST=true

# Optional lifecycle policy setting for ecr-create-repository.sh
# IMAGE_RETENTION_COUNT=10
