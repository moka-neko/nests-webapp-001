generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 先生応募データ（旧GASスプレッドシート「先生応募一覧」に対応）
model TeacherApplication {
  id              String                   @id @default(uuid())
  email           String
  nameKanji       String
  nameKatakana    String
  age             Int
  workLocation    String
  resumeUrl       String? // 旧形式（外部URL）。履歴書フォーム入力への移行に伴い任意化
  questions       String?
  status          TeacherApplicationStatus @default(PENDING)
  lineDisplayName String? // LINEログイン後に追記
  lineUserId      String? // LINEログイン後に追記
  meetingUrl      String? // TimeRex Webhook後に追記
  submittedAt     DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  resume          TeacherResume?
}

// 先生応募の履歴書（フォームに直接入力された内容）
model TeacherResume {
  id             String             @id @default(uuid())
  applicationId  String             @unique
  application    TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  photoUrl       String? // 顔写真（Supabase Storage の公開URL）
  birthDate      String? // 生年月日（YYYY-MM-DD）
  gender         String? // 性別（任意回答）
  phoneNumber    String? // 電話番号
  postalCode     String? // 郵便番号
  address        String? // 現住所
  nearestStation String? // 最寄り駅
  education      Json? // 学歴 [{ yearMonth, description }]
  workHistory    Json? // 職歴 [{ yearMonth, description }]
  qualifications Json? // 免許・資格 [{ yearMonth, description }]
  motivation     String? // 志望動機
  selfPromotion  String? // 自己PR
  hobbies        String? // 趣味・特技
  requests       String? // 本人希望記入欄
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

enum TeacherApplicationStatus {
  PENDING
  INTERVIEW
  HIRED
  REJECTED
}

// 生徒応募データ（Googleフォーム「生徒募集」に対応）
model StudentApplication {
  id          String   @id @default(uuid())
  email       String
  name        String
  phoneNumber String
  nationality String
  questions   String?
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 運営管理者（管理 API ログイン用）
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  totpSecret   String?  // AES-256-GCM で暗号化した TOTP シークレット
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
