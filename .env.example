# Database
# Supabase PostgreSQL pooled connection URL (Transaction pooler)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase PostgreSQL direct connection URL (used by Prisma migrations)
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# JWT (管理者ログイン)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=28800
MFA_TOKEN_EXPIRES_IN_SECONDS=300

# TOTP シークレット暗号化キー（未設定時は JWT_SECRET を使用）
MFA_ENCRYPTION_KEY=

# 初期管理者（初回起動時に自動作成）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=管理者

# 応募受付 API キー（設定時は POST 応募 API に x-api-key ヘッダーが必須）
APPLICATION_API_KEY=

# TimeRex Webhook シークレット（設定時は x-webhook-secret ヘッダーが必須）
TIMEREX_WEBHOOK_SECRET=

# 毎週月曜の面接日程リマインド（POST /api/v1/jobs/weekly-interview-reminder の x-cron-secret）
CRON_SECRET=
# 通知文に載せる管理画面のベース URL（未設定時は http://localhost:5173）
ADMIN_APP_BASE_URL=http://localhost:5173
# 月曜リマインドのメール送信先（カンマ区切り。未設定時は管理者アカウントのメールアドレス）
OPERATOR_NOTIFICATION_EMAILS=

# Google Meet 発行（Google カレンダー API。教室の Google アカウントの OAuth リフレッシュトークン）
# 未設定時は管理画面で面接URLを手動入力して通知する
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# 予定を作るカレンダー（未設定時は primary）
GOOGLE_CALENDAR_ID=
# true にすると Google からも応募者へカレンダー招待メールを送る（既定: 送らない。URL は本アプリのメール・LINE で共有）
GOOGLE_SEND_CALENDAR_INVITES=false
# 面接の所要時間（分、未設定時は 30）
INTERVIEW_DURATION_MINUTES=30

# CORS（カンマ区切り。未設定時は全オリジン許可）
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# LINE Login (OAuth)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=http://localhost:3000/api/v1/auth/line/callback

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=

# Mail (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=友達先生日本語会話教室 <noreply@example.com>

# Server
PORT=3000
