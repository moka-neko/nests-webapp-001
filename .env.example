# Database
# Supabase PostgreSQL pooled connection URL (Transaction pooler)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase PostgreSQL direct connection URL (used by Prisma migrations)
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# JWT (管理者ログイン)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=28800
MFA_TOKEN_EXPIRES_IN_SECONDS=300

# TOTP シークレット暗号化キー（未設定時は JWT_SECRET を使用）
MFA_ENCRYPTION_KEY=

# 初期管理者（初回起動時に自動作成）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=管理者

# 応募受付 API キー（設定時は POST 応募 API に x-api-key ヘッダーが必須）
APPLICATION_API_KEY=

# Supabase Storage（履歴書の顔写真アップロード用）
# SUPABASE_URL: https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: サービスロールキー（サーバー専用・絶対に公開しない）
# SUPABASE_STORAGE_BUCKET: 画像を保存する公開バケット名（省略時: teacher-photos）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=teacher-photos

# TimeRex Webhook シークレット（設定時は x-webhook-secret ヘッダーが必須）
TIMEREX_WEBHOOK_SECRET=

# CORS（カンマ区切り。未設定時は全オリジン許可）
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# LINE Login (OAuth)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=http://localhost:3000/api/v1/auth/line/callback

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=

# 公式アカウント友だち追加（未設定時は LINE_CHANNEL_ACCESS_TOKEN で Bot 情報から basicId を取得）
# LINE_OA_BASIC_ID: 公式アカウントのベーシック ID（例: @xxxx）
LINE_OA_BASIC_ID=
# LINE_ADD_FRIEND_URL: lin.ee など友だち追加の完全 URL（設定時は最優先）
LINE_ADD_FRIEND_URL=

# Mail (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=塾応募管理 <noreply@example.com>

# Server
PORT=3000
